<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>controllers</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="rkumar@dfki.de">rkumar</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- Stage interface contract test (issue #5, M1.5); see
       doc/modularity/contract_tests.md. -->
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- Plugin discovery test (issue #6, M2.1): reads the pluginlib ament resource. -->
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <depend>rclcpp</depend>
  </export>


  <depend>interfaces</depend>
  <depend>simulator</depend>
  <depend>common</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <!-- Plugin host foundation (issue #6, M2.1): pluginlib discovers and loads the
       control-pipeline stages exported through StagePlugin<Interface>. See
       doc/modularity/plugin_lifecycle.md and doc/modularity/plugin_discovery.md. -->
  <depend>pluginlib</depend>
  <!-- Exported alongside the shared pipeline type surface (issue #3): the
       installed headers in include/mit_controller/ are Eigen aggregates, so
       consumers of this package need Eigen too. -->
  <depend>eigen</depend>
</package>
