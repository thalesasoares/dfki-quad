<!--
  Contact-logic stage plugins (issue #6, M2.1; class added by issue #12, M3.1).

  base_class_type: StagePlugin<ContactLogicInterface>
    (mit_controller/stage_plugin.hpp + mit_controller/contact_logic_interface.hpp)

  M2.1 defined this discovery point while the FSM was still inline in the host,
  so that M3.1's extraction would be purely additive. It was: the only change
  here is the <library> block below.

  The `<` and `>` of base_class_type must stay XML-escaped. pluginlib compares
  the attribute against the string StageLoader passes (stage_plugin_bases::
  kContactLogic), so an unescaped angle bracket is not a parse error with a clear
  message — it is a class that silently fails to be declared.
-->
<class_libraries>
  <library path="contact_logic_plugins">
    <class name="default_contact_logic"
           type="stock_plugins::DefaultContactLogicPlugin"
           base_class_type="StagePlugin&lt;ContactLogicInterface&gt;">
      <description>
        The stock contact reconciliation stage: the per-leg early/late/lost contact FSM that
        ran inline in the control loop until M3.1, reconciling the planned contact schedule
        with the sensed foot contacts.
      </description>
    </class>
  </library>
</class_libraries>
